index e6d38d3..a83fb6f 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -46,6 +46,9 @@
 #include <kern/cpu_data.h>
 #include <kern/sched_prim.h>
 #include <libkern/section_keywords.h>
+#if XNU_QCOM_USB_DEBUG
+#include <QcomXnuUsbDebug.h>
+#endif
 
 #if __arm64__
 #include <machine/machine_routines.h>
@@ -523,6 +526,23 @@ console_resume()
 void
 console_write(char *str, int size)
 {
+#if XNU_QCOM_USB_DEBUG
+	/* Capture raw formatted bytes before this function can reject them:
+	 * 10063 returns early when console output is disabled, ahead of the
+	 * ring, so the capture precedes that check. The native API accepts at
+	 * most 16 KiB per call; submit every chunk so a long console write
+	 * does not lose its suffix to that call budget.
+	 */
+	if (str != NULL) {
+		for (int offset = 0; offset < size;) {
+			int bytes = size - offset;
+			if (bytes > 16384) bytes = 16384;
+			(void)qcom_usb_debug_write(str + offset, (size_t)bytes);
+			offset += bytes;
+		}
+	}
+#endif
+
 	if (disableConsoleOutput) {
 		return;
 	}
@@ -608,6 +628,13 @@ console_write(char *str, int size)
 void
 console_write_unbuffered(char c)
 {
+#if XNU_QCOM_USB_DEBUG
+	/* Tee raw bytes once, before the selected console's CRLF expansion
+	 * and ahead of the disabled-output early return, which must not be
+	 * able to drop them.
+	 */
+	qcom_usb_debug_putc(c);
+#endif
 	if (disableConsoleOutput) {
 		return;
 	}
