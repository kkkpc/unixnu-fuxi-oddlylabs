diff --git a/osfmk/kern/printf.c b/osfmk/kern/printf.c
index aeac9d3..3c666f1 100644
--- a/osfmk/kern/printf.c
+++ b/osfmk/kern/printf.c
@@ -913,14 +913,35 @@ vprintf(const char *fmt, va_list ap)
 	return vprintf_internal(fmt, ap, __builtin_return_address(0));
 }
 
+#if XNU_QCOM_USB_DEBUG
+#include <QcomXnuUsbDebug.h>
+/* The 10063 serial_console.c global is declared in no header. */
+extern int disableConsoleOutput;
+#endif
+
 void
 consdebug_putc(char c)
 {
+#if XNU_QCOM_USB_DEBUG
+	/* A PE console fallback supplies the one console/USB emission below.
+	 * Other routes are captured centrally, or here if console is disabled.
+	 * 10063 moved the disableConsoleOutput guard into console_write, past
+	 * its capture point, so the guard is re-expressed here: calling the
+	 * write while disabled would capture the character a second time.
+	 */
+	const bool usb_via_pe_console = !console_is_serial() && !disable_serial_output &&
+	    PE_kputc == console_write_unbuffered;
+	if (disableConsoleOutput && !usb_via_pe_console) qcom_usb_debug_putc(c);
+	if (!usb_via_pe_console && !disableConsoleOutput)
+#endif
 	console_write_char(c);
 
 	debug_putc(c);
 
 	if (!console_is_serial() && !disable_serial_output) {
+#if XNU_QCOM_USB_DEBUG
+		if (PE_kputc && PE_kputc != qcom_usb_debug_putc)
+#endif
 		PE_kputc(c);
 	}
 }
@@ -928,11 +949,26 @@ consdebug_putc(char c)
 void
 consdebug_putc_unbuffered(char c)
 {
+#if XNU_QCOM_USB_DEBUG
+	/* A PE console fallback supplies the one console/USB emission below.
+	 * Other routes are captured centrally, or here if console is disabled.
+	 * 10063 moved the disableConsoleOutput guard into console_write, past
+	 * its capture point, so the guard is re-expressed here: calling the
+	 * write while disabled would capture the character a second time.
+	 */
+	const bool usb_via_pe_console = !console_is_serial() && !disable_serial_output &&
+	    PE_kputc == console_write_unbuffered;
+	if (disableConsoleOutput && !usb_via_pe_console) qcom_usb_debug_putc(c);
+	if (!usb_via_pe_console && !disableConsoleOutput)
+#endif
 	console_write_unbuffered(c);
 
 	debug_putc(c);
 
 	if (!console_is_serial() && !disable_serial_output) {
+#if XNU_QCOM_USB_DEBUG
+		if (PE_kputc && PE_kputc != qcom_usb_debug_putc)
+#endif
 		PE_kputc(c);
 	}
 }
diff --git a/pexpert/arm/pe_kprintf.c b/pexpert/arm/pe_kprintf.c
index 65144c7..a33d6fb 100644
--- a/pexpert/arm/pe_kprintf.c
+++ b/pexpert/arm/pe_kprintf.c
@@ -12,6 +12,10 @@
 #include <kern/simple_lock.h>
 #include <os/log_private.h>
 #include <libkern/section_keywords.h>
+#if XNU_QCOM_USB_DEBUG
+#include <QcomXnuUsbDebug.h>
+#endif
+
 
 /* Globals */
 typedef void (*PE_kputc_t)(char);
@@ -26,6 +30,24 @@ SECURITY_READ_ONLY_LATE(bool) disable_kprintf_output = true;
 SECURITY_READ_ONLY_LATE(bool) disable_iolog_serial_output = false;
 SECURITY_READ_ONLY_LATE(bool) enable_dklog_serial_output = false;
 
+#if XNU_QCOM_USB_DEBUG
+static bool qcom_usb_debug_kprintf_requested;
+static void
+qcom_usb_tee(char c)
+{
+	/* The fallback console sink performs its own raw USB tee. */
+	if (PE_kputc == console_write_unbuffered) {
+		PE_kputc(c);
+		return;
+	}
+	qcom_usb_debug_putc(c);
+	if (PE_kputc && PE_kputc != qcom_usb_debug_putc) PE_kputc(c);
+}
+#define QCOM_USB_DEBUG_KPRINTF_PUTC qcom_usb_tee
+#else
+#define QCOM_USB_DEBUG_KPRINTF_PUTC PE_kputc
+#endif
+
 static SIMPLE_LOCK_DECLARE(kprintf_lock, 0);
 
 static void serial_putc_crlf(char c);
@@ -50,6 +72,11 @@ PE_init_kprintf_config(void)
 		disable_kprintf_output = false;
 	}
 #endif
+#if XNU_QCOM_USB_DEBUG
+	/* Defer requested verbose output until the early sink is installed. */
+	qcom_usb_debug_kprintf_requested = !disable_kprintf_output;
+	disable_kprintf_output = true;
+#endif
 }
