# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# y and n are 1 and 0, a quoted string or a number is passed through, {tree} is the build tree.
# The template configuration (examples/device) on top of the arch, SoC and OS fragments, plus the touch archive.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# Native UFS root (UniXNU ShengUfs, the SM8550 UFS transport): the full OS lives in the
# userdata reserve and is mounted read-only as root, as on UniXNU-sheng's iPadOS 17 profile.
# The owner-root chain is ON (owner decision 2026-11-05, reversing the 2026-11-04
# first-boot simplification): with the chain off, the device mounted the UFS root and then
# panicked "rootvp not authenticated after mounting" (bsd_init.c) — on a non-macOS target
# the FSIOC_KERNEL_ROOTAUTH check has no other pass than the owner authorization the
# chain provides (offline-owner-root-binding-audit.patch), so the chain is load-bearing,
# not hardening. Its policy pipeline is frozen to the IPSW payload (the OS volume UUID
# 04769D26 and the image digests in UniXNU's scripts are this iPadOS 17.7.11 image's own
# constants, identical for fuxi), and scripts/build-fuxi-owner-root.py runs it inside the
# kernel build with a per-build owner keypair. The driver is vendored in package/ufs/ and
# built by scripts/build-fuxi-ufs.py with the verified-block define, mirroring the catalog
# component build. VIRTIO_BLOCK is on because the build script's owner-root guard
# requires it (Build #10) and the ShengUfs component declares the dependency; the
# bindings the Build #12 audit wanted are generated by build-virtio-mmio-bindings.py.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_BOOT_PROGRESS=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
# The scratch Data stage (patches/xnu-12377/offline-owner-systemos-mount.patch): BOOT_MANIFEST is the data
# mount's own guard and makes the cache prepare publish the boot manifest; DATA_MOUNT then mounts the
# payload's Data seed (Payloads/scratch-data.img, a RAM disk) writable at /private/var before launchd is
# exec'd, selecting the volume by this UUID through NativeRamBlock's native_ram_block_volume_seed. The
# UUID is the one upstream pins (scripts/build-cpu-desktop-kernel.py); scripts/build-fuxi-data-seed.py
# builds the seed in the image job and rewrites its volume UUID to this value. Sheng's defconfig carries
# the same three settings with the same UUID. The seed is ephemeral (no persistent store on this board).
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
# The successful V2 path enables the native A740 driver and presents through the
# same GOP/legacy display handoff.
CONFIG_XNU_NATIVE_ADRENO=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
# Without this the BCM2837 target maps PLATFORM_PANIC_LOG_PADDR (0x3c0fc000, RAM on a Raspberry Pi 3) in PE_create_console,
# reads it and zeroes 16 KiB there. On SM8550 no RAM or device tree node covers that address. With it the region comes
# from the device tree, and the ADT has no /pram node, so no panic region is mapped.
CONFIG_XNU_DT_PANIC_REGION=y
# AMFI waits for an ApplePMGRNub service: the PMGR bridge (scripts/build-fuxi-platform-power.py, boot argument
# sheng-pmgr=2) publishes the original one. Its power operations stop with a panic; it is not power management.
CONFIG_XNU_SHENG_PMGR=y
# The RAM block (UniXNU RamBlock's NativeRamBlock, scripts/build-fuxi-ram-block.py): the native personality starts it, and it
# publishes a RAM disk the loader hands over (/chosen/memory-map RAMDisk or PackedRAMDisk) as a block device, which APFS
# attaches to. Without a RAM disk its start returns false and nothing else changes.
CONFIG_XNU_NATIVE_RAM_BLOCK=y
# bsd_init calls native_touch_probe() (patches/xnu/fuxi-touch-probe.patch); scripts/build-fuxi-touch.py builds it. The
# HID digitizer (scripts/build-fuxi-hid-input.py) is force-loaded: its objects carry the absolute IOHIDDevice bindings and
# the metaclass registration that kits/fuxi/FuxiHidProbe.cpp runs after IOHIDFamily is loaded. The QcomXnuUsbDebug
# archive (scripts/build-fuxi-usb-debug.py, the vendored ljhhkx529 module at drivers/QcomXnuUsbDebug) is force-loaded
# the same way: the patched console/kprintf/panic units call into it, and force-loading keeps its singleton state and
# control hooks present regardless of which hook a given build exercises.
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/fuxi-touch/libFuxiTouch.a -Wl,-force_load,{tree}/build/sheng-hid-input/libShengHidInput.a -Wl,-force_load,{tree}/build/qcom-usb-debug/libQcomXnuUsbDebug.a"
